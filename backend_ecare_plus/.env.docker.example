# Copy to .env.docker, then fill the empty required values.
POSTGRES_DB=ecare_plus
DB_USERNAME=ecare_plus
DB_PASSWORD=
APP_JWT_SECRET=
APP_JWT_TTL=PT1H
HTTP_PORT=8080
# Replace with the actual frontend origin when deploying.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000

# Optional: required for password recovery by email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
